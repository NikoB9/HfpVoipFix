<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hfpvoipfix"
    android:versionCode="70"
    android:versionName="1.9.7-lab">

    <uses-sdk
        android:minSdkVersion="30"
        android:targetSdkVersion="30" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <application
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:icon="@drawable/ic_launcher"
        android:label="HFP VoIP Lab">

        <activity android:name=".RelayActivity" android:exported="true" android:configChanges="orientation|screenSize"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
        <activity android:name=".ModeActivity" android:exported="false" android:configChanges="orientation|screenSize" />
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Laboratoire HFP Android 11 : modes dynamiques et diagnostic intégré" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <service android:name=".RelayService" android:exported="false" android:stopWithTask="false" />
        <receiver android:name=".RelayBootReceiver" android:exported="true"><intent-filter><action android:name="android.intent.action.BOOT_COMPLETED"/><action android:name="android.intent.action.MY_PACKAGE_REPLACED"/></intent-filter></receiver>
        <service android:name=".CaptureService" android:exported="false" android:stopWithTask="false" />
        <service android:name=".RxBridgeService" android:exported="false" android:foregroundServiceType="microphone|mediaPlayback" android:stopWithTask="false" />
        <service android:name=".FirmwareService" android:exported="false" android:stopWithTask="false" />
        <provider android:name=".ReportProvider" android:authorities="com.hfpvoipfix.report" android:exported="false" android:grantUriPermissions="true" />
        <!-- LSPosed legacy-module recommended scope. -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>
</manifest>
